rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsChat(chatId) {
      return signedIn() &&
        get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if ownsUser(userId);
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if signedIn() && resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow create: if ownsChat(chatId) && request.resource.data.userId == request.auth.uid;
        allow read, update, delete: if ownsChat(chatId);
      }
    }
  }
}
